* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.parquet binary
*.tif binary
*.tiff binary
*.nc binary
*.zip binary

# Generated audit artifacts carry byte-level provenance locks. Preserve their
# exact serialized bytes instead of applying Git newline normalization.
manifests/** -text whitespace=cr-at-eol
reports/tables/** -text whitespace=cr-at-eol
reports/DEVELOPMENT_REPORT.md -text whitespace=cr-at-eol
reports/DEVELOPMENT_REPORT_provenance.json -text whitespace=cr-at-eol
atlas/public/evidence/** -text whitespace=cr-at-eol
atlas/app/cities/generated-results.ts -text
